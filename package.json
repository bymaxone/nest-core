{
  "name": "@bymax-one/nest-core",
  "version": "1.2.1",
  "description": "Zero-dependency NestJS 11 application foundation kit: error-envelope exception filter, request-timing interceptor, pagination helpers, health endpoints with indicator discovery, an optional Prometheus metrics endpoint with a contribution contract, OpenAPI documents in development, and OpenTelemetry trace correlation.",
  "author": "Bymax One <support@bymax.one>",
  "license": "MIT",
  "homepage": "https://github.com/bymaxone/nest-core#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bymaxone/nest-core.git"
  },
  "bugs": {
    "url": "https://github.com/bymaxone/nest-core/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pagination": {
      "import": {
        "types": "./dist/pagination/index.d.ts",
        "default": "./dist/pagination/index.mjs"
      },
      "require": {
        "types": "./dist/pagination/index.d.cts",
        "default": "./dist/pagination/index.cjs"
      }
    },
    "./health": {
      "import": {
        "types": "./dist/health/index.d.ts",
        "default": "./dist/health/index.mjs"
      },
      "require": {
        "types": "./dist/health/index.d.cts",
        "default": "./dist/health/index.cjs"
      }
    },
    "./metrics": {
      "import": {
        "types": "./dist/metrics/index.d.ts",
        "default": "./dist/metrics/index.mjs"
      },
      "require": {
        "types": "./dist/metrics/index.d.cts",
        "default": "./dist/metrics/index.cjs"
      }
    },
    "./openapi": {
      "import": {
        "types": "./dist/openapi/index.d.ts",
        "default": "./dist/openapi/index.mjs"
      },
      "require": {
        "types": "./dist/openapi/index.d.cts",
        "default": "./dist/openapi/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm clean && tsup",
    "check:exports": "attw --pack . --profile strict",
    "check:mutants": "node scripts/check-mutation-directives.mjs",
    "check:published": "node scripts/check-published-surface.mjs",
    "check:runtime": "node scripts/check-consumer-runtime.mjs",
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['dist','coverage'])fs.rmSync(d,{recursive:true,force:true})\"",
    "dogfood": "node scripts/dogfood-smoke-test.mjs",
    "lint": "eslint --no-error-on-unmatched-pattern src scripts test",
    "lint:fix": "eslint --no-error-on-unmatched-pattern src scripts test --fix",
    "mutation": "stryker run",
    "mutation:full": "node -e \"require('node:fs').rmSync('reports/stryker-incremental.json',{force:true,recursive:true})\" && stryker run",
    "mutation:dry-run": "stryker run --dryRunOnly",
    "prepare": "husky",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm check:mutants && pnpm test:cov:all && pnpm build && pnpm size && pnpm check:published",
    "release": "npm publish --provenance --access public",
    "size": "node scripts/check-size.mjs",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:cov:all": "jest --config jest.coverage.config.ts --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.16",
    "@nestjs/core": "^11.1.18",
    "@nestjs/swagger": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "prom-client": "^15.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.4",
    "@nestjs/common": "^11.1.20",
    "@nestjs/core": "^11.1.20",
    "@nestjs/platform-express": "^11.1.20",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/testing": "^11.1.20",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@stryker-mutator/core": "^9",
    "@stryker-mutator/jest-runner": "^9",
    "@stryker-mutator/typescript-checker": "^9",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "prettier": "^3.8.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "nestjs",
    "error-envelope",
    "exception-filter",
    "request-timing",
    "pagination",
    "health-check",
    "prometheus",
    "metrics",
    "openapi",
    "swagger",
    "opentelemetry",
    "tracing",
    "typescript"
  ],
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "module": "./dist/index.mjs",
  "typesVersions": {
    "*": {
      "pagination": [
        "./dist/pagination/index.d.cts"
      ],
      "health": [
        "./dist/health/index.d.cts"
      ],
      "openapi": [
        "./dist/openapi/index.d.cts"
      ],
      "metrics": [
        "./dist/metrics/index.d.cts"
      ]
    }
  }
}
