# Generated lockfile. pnpm owns its format; Prettier must never reformat it.
# Reformatting churns thousands of lines and breaks `pnpm install --frozen-lockfile`
# in CI (the on-disk lockfile no longer matches what pnpm generates).
pnpm-lock.yaml

# Build / coverage / report output (also gitignored). Never source-format.
dist/
coverage/
reports/

# Phase task files use 4-backtick Agent-prompt fences (see docs/tasks/README.md)
# so each prompt can itself contain triple-backtick code blocks. Prettier
# normalizes these to 3 backticks, which breaks the convention and any nested
# block; leave these authored files untouched.
docs/tasks/phase-*.md
